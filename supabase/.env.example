# Copy this file to supabase/.env (git ignores it) and fill in the values.
# These are server secrets: they never go in the app or in mobile/.env.local.
# After changing this file, restart the local server (Stop KILN, then Start KILN).

# Claude, for KILN's AI helpers (supabase/functions/ai). Get one at console.anthropic.com.
# Empty = the app runs without AI suggestions.
ANTHROPIC_API_KEY=

# This computer's own server keys. Without them the local server uses Supabase's default keys,
# which are the same everywhere and published online: through the phone tunnel, anyone could
# read every business. Start KILN fills these in with random values if they're empty and won't
# open the tunnel while the defaults still work. After they change, run once:
# npx supabase stop, then npx supabase start (data is kept). Testers then sign in again.
SUPABASE_AUTH_JWT_SECRET=
SUPABASE_AUTH_SECRET_KEY=
