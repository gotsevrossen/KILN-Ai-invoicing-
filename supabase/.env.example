# Copy this file to supabase/.env (git ignores it) and fill in the values.
# These are server secrets: they never go in the app or in mobile/.env.local.
# After changing this file, restart the local server: npx supabase stop, then npx supabase start.

# Claude, for KILN's AI helpers (supabase/functions/ai). Get one at console.anthropic.com.
# Empty = the app runs without AI suggestions.
ANTHROPIC_API_KEY=

# Private server keys. Supabase's built-in local ones are public, and phones reach this server
# over the internet, so KILN uses its own. Start KILN refuses to open the phone address without them.
# Make each one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# (put sb_secret_ in front of the second one). Changing them signs everyone out.
KILN_JWT_SECRET=
KILN_SECRET_KEY=

# Stripe, for online payments (Apple Pay / Google Pay and bank). From dashboard.stripe.com in
# test mode (keys start with sk_test_ / pk_test_) until KILN takes real money. Connect must be
# turned on for the account (Connect > Get started). Empty = invoices send, but can't be paid online.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint pointed at <server>/functions/v1/stripe-webhook, listening to
# "Events on Connected accounts": payment_intent.processing, payment_intent.succeeded,
# payment_intent.payment_failed. Locally: stripe listen --forward-connect-to <that address>.
STRIPE_WEBHOOK_SECRET=

# Where customers open invoices: the web address of KILN's pay page, with no slash at the end.
# Hosted: https://kiln.expo.app. Laptop testing: Expo's tunnel address (https://<id>-rosseng-8081.exp.direct),
# which serves the same page from the running Expo and stays the same between starts.
KILN_PAY_URL=
