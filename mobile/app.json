{
  "expo": {
    "name": "KILN",
    "slug": "kiln",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kiln",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.rosseng.kiln"
    },
    "android": {
      "package": "com.rosseng.kiln",
      "adaptiveIcon": {
        "backgroundColor": "#F0844C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E9E9E9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "KILN adds photos you choose to your jobs, and reads receipts and old invoices you pick.",
          "cameraPermission": "KILN takes photos of your jobs, receipts, and old invoices."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KILN saves where job photos are taken, as proof of work. Customers see it only if you choose."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "KILN listens while you record a voice note, to turn it into text.",
          "speechRecognitionPermission": "KILN turns your voice notes into text with your phone's speech recognition."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d48caeea-c5b3-4089-9b00-2db27b3d9b24"
      }
    },
    "owner": "rosseng"
  }
}
