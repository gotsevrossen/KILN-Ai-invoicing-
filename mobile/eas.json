{
  "cli": {
    "version": ">= 25.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "ios-personal-test": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "samsung-preview": {
      "extends": "preview",
      "environment": "preview",
      "android": {
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a -Pexpo.gif.enabled=false -Pexpo.webp.enabled=false"
      }
    }
  }
}
