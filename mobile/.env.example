# Copy this file to .env.local (git ignores it) and fill in the values.
# Leave both empty to run the app in example mode (no server, example data).
#
# Local Supabase: run `npx supabase start` in the repo folder; it prints these.
# On a phone, 127.0.0.1 means the phone itself, so use your Cloudflare Tunnel
# address (or your computer's address on the same Wi-Fi) instead.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
