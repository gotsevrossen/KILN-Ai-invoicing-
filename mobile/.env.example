# Copy this file to .env.local (git ignores it) and fill in the values.
# Leave both empty to run the app in example mode (no server, example data).
#
# Local Supabase: run `npx supabase start` in the repo folder; it prints these.
# On a phone, 127.0.0.1 means the phone itself, so use your Cloudflare Tunnel
# address (or your computer's address on the same Wi-Fi) instead.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional HTTPS recovery callback if the project sends password-reset links.
# Add the same URL to the project's Auth redirect allowlist.
EXPO_PUBLIC_PASSWORD_RESET_URL=

# KILN subscription (RevenueCat). These are RevenueCat's public app keys, meant to be in the app;
# the secret key goes only in the server's secrets. Leave empty until the stores are set up.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Links on the subscribe screen (Apple requires both before review).
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
